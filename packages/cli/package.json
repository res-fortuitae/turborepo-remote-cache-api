{
  "name": "@repo/cli",
  "version": "0.1.1",
  "private": true,
  "bin": {
    "tcache": "./src/bin.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test src",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "package:release": "bun scripts/package.ts",
    "bench:startup": "bun scripts/benchmark.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.6",
    "@repo/client-core": "workspace:*",
    "@repo/shared": "workspace:*",
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
