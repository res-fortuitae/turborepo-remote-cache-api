{
  "name": "@repo/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./oxlint": "./oxlint.ts",
    "./oxfmt": "./oxfmt.ts",
    "./plugins/t3code": "./vendor/t3code/index.ts",
    "./plugins/anti-slop": "./vendor/anti-slop/index.ts",
    "./plugins/anti-slop-effect": "./vendor/anti-slop/effect/index.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --test vendor/anti-slop/rules/*.test.ts vendor/anti-slop/effect/rules/*.test.ts && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "1.89.0",
    "@shekohex/oxc-effect": "0.2.1",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "effect": "4.0.0-rc.112",
    "eslint-plugin-playwright": "2.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "30.1.3",
    "typescript": "^6.0.2",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  }
}
