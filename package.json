{
  "name": "turborepo-remote-cache-api",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/api dev",
    "deploy": "bun run --cwd apps/api deploy",
    "destroy": "bun run --cwd apps/api destroy",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run typecheck && bun run format:check"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10"
  },
  "packageManager": "bun@1.4.3"
}
