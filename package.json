{
  "name": "turborepo-remote-cache-api",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun apps/server/scripts/alchemy.ts dev",
    "deploy": "bun apps/server/scripts/alchemy.ts deploy",
    "destroy": "bun apps/server/scripts/alchemy.ts destroy",
    "typecheck": "bun check && turbo run typecheck",
    "test": "bun test scripts && turbo run test",
    "test:live": "bun test apps/server/tests/live.test.ts",
    "test:stack": "bun run dashboard:build && ALCHEMY_TEST=1 ALCHEMY_TEST_DEV=1 bun test --timeout 600000 tests/stack.test.ts",
    "test:deployed": "bun run dashboard:build && ALCHEMY_TEST=1 ALCHEMY_TEST_DEV=0 bun test --timeout 600000 tests/stack.test.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run check:boundaries && bun run db:check && bun run lint && bun run typecheck && bun run format:check",
    "plan": "bun apps/server/scripts/alchemy.ts plan",
    "setup": "bun apps/server/scripts/setup.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:check": "bun run --cwd packages/db db:check",
    "dashboard:dev": "bun run --cwd apps/dashboard dev",
    "dashboard:build": "bun run --cwd apps/dashboard build",
    "perf:smoke": "bun apps/server/scripts/perf-verify.ts",
    "perf:local": "bun apps/server/scripts/perf-local.ts",
    "perf:proxy": "bun packages/cli/bench/proxy.ts --paced",
    "perf:exchange": "bun apps/server/scripts/perf-exchange.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-bun": "^4.0.6",
    "@effect/platform-node": "^4.0.6",
    "@repo/client-core": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/deploy-config": "workspace:*",
    "@repo/infra": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24",
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.6",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10",
    "typescript": "^7",
    "typescript-parser": "npm:typescript@^6.0.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "@simplewebauthn/server": "13.3.3",
    "@vitest/mocker": "4.1.12",
    "hono": "4.13.14",
    "lodash": "4.18.1",
    "sharp": "0.35.5",
    "undici@7": "7.30.1",
    "valibot": "1.5.0",
    "vitest": "4.1.12"
  },
  "packageManager": "bun@1.4.3"
}
