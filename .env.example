TURBO_TOKEN=change-me
# Stored in the account Secrets Store as <stage>_<NAME>. Generate with `openssl rand -hex 32`.
CACHE_TOKEN_SIGNING_KEY=change-me
BETTER_AUTH_SECRET=change-me
# Set together with deploy.config.ts githubApp to enable GitHub OAuth (STV-433).
# GITHUB_OAUTH_CLIENT_SECRET=
# Optional Basin SQL credential.
# BASIN_SQL_TOKEN=
# Deploy-time only: Cloudflare API token with R2 Data Catalog write access. When set (and no
# jurisdiction is configured), audit events are exported to the Basin `audit.audit_log` table.
# BASIN_CATALOG_TOKEN=
