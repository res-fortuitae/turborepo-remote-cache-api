{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config/**",
        "$TURBO_ROOT$/tsconfig.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/oxlint.config.mts",
        "$TURBO_ROOT$/oxlint.config.mts",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/packages/*/oxlint.config.mts"
      ],
      "outputs": []
    }
  }
}
